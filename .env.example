# App/runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=UTC

# Database
POSTGRES_DB=<required_postgres_database_name>
POSTGRES_USER=<required_postgres_username>
POSTGRES_PASSWORD=<required_strong_postgres_password>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Strava (required)
STRAVA_CLIENT_ID=<required_strava_app_client_id>
STRAVA_CLIENT_SECRET=<required_strava_app_client_secret>
STRAVA_WEBHOOK_VERIFY_TOKEN=<required_random_strava_verify_token>
STRAVA_SCOPES=activity:read,activity:write,profile:read_all
STRAVA_ALLOWED_ATHLETE_ID=14460791

# Telegram (required)
TELEGRAM_BOT_TOKEN=<required_botfather_bot_token>
TELEGRAM_WEBHOOK_SECRET=<required_long_random_webhook_secret>
TELEGRAM_ALLOWED_USER_ID=<required_numeric_telegram_user_id>
TELEGRAM_WEBHOOK_URL=<required_public_https_url_plus_/api/telegram/webhook/{secret}>

# Security/auth
APP_SECRET_KEY=<required_random_32_plus_char_secret>
JWT_SECRET=<optional_if_reusing_APP_SECRET_KEY_random_32_plus_char_secret>
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=2
JWT_COOKIE_NAME=strava_auth
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax
JWT_COOKIE_DOMAIN=
PUBLIC_BASE_URL=<required_for_webhook_registration_https_base_url>

# UI
FRONTEND_BASE_URL=<optional_defaults_to_PUBLIC_BASE_URL_if_unset>
UI_PORT=3001
UI_API_BASE_URL=/api
VITE_API_BASE_URL=/api

# Optional tunnel values for local webhook testing via Docker
TUNNEL_PROVIDER=cloudflared
CLOUDFLARED_TUNNEL_TOKEN=<required_if_using_cloudflared_tunnel_run_token>
NGROK_AUTHTOKEN=<required_if_using_ngrok>
TUNNEL_DOMAIN=<required_if_using_fixed_tunnel_domain>
