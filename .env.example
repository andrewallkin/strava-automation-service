# App/runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=UTC

# Database
POSTGRES_DB=<required_postgres_database_name>
POSTGRES_USER=<required_postgres_username>
POSTGRES_PASSWORD=<required_strong_postgres_password>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Strava (required)
STRAVA_CLIENT_ID=<required_strava_app_client_id>
STRAVA_CLIENT_SECRET=<required_strava_app_client_secret>
STRAVA_WEBHOOK_VERIFY_TOKEN=<required_random_strava_verify_token>
STRAVA_SCOPES=read,activity:read,activity:read_all,activity:write,profile:read_all
STRAVA_ALLOWED_ATHLETE_ID=14460791

# Telegram (required)
TELEGRAM_BOT_TOKEN=<required_botfather_bot_token>
TELEGRAM_WEBHOOK_SECRET=<required_long_random_webhook_secret>
TELEGRAM_ALLOWED_USER_ID=<required_numeric_telegram_user_id>

# Coach Telegram bot (required for conversational coach bot)
COACH_TELEGRAM_BOT_TOKEN=<required_second_botfather_bot_token>
COACH_TELEGRAM_WEBHOOK_SECRET=<required_long_random_coach_webhook_secret>
COACH_TELEGRAM_ALLOWED_USER_ID=<required_numeric_telegram_user_id>
COACH_CONVERSATION_HISTORY_USER_TURN_LIMIT=20
COACH_LINK_CODE_TTL_SECONDS=600

# Redis (required for coach conversation history + link codes)
REDIS_URL=redis://redis:6379/0

# Security/auth
APP_SECRET_KEY=<required_random_32_plus_char_secret>
JWT_SECRET=<optional_if_reusing_APP_SECRET_KEY_random_32_plus_char_secret>
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=30
JWT_COOKIE_NAME=strava_auth
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax
JWT_COOKIE_DOMAIN=
PUBLIC_BASE_URL=<required_https_base_url_used_for_webhook_url_derivation>

# OpenAI (optional — set in dashboard Settings → OpenAI; use this only for local/dev override)
# If you change APP_SECRET_KEY, re-save the OpenAI key in Settings (encrypted rows become unreadable).
OPENAI_API_KEY=
MCP_SERVER_URL=
STRAVA_MCP_BEARER=

# UI
FRONTEND_BASE_URL=<optional_defaults_to_PUBLIC_BASE_URL_if_unset>
UI_PORT=3001
UI_API_BASE_URL=/api
VITE_API_BASE_URL=/api
