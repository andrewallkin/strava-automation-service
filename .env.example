# Copy to `.env` and fill in real values. This file is safe to commit.

# -----------------------------------------------------------------------------
# App / runtime
# APP_ENV: `development` disables webhook registration at startup.
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
POSTGRES_DB=<required_postgres_database_name>
POSTGRES_USER=<required_postgres_username>
POSTGRES_PASSWORD=<required_strong_postgres_password>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Strava (required)
# STRAVA_ALLOWED_ATHLETE_ID: numeric athlete id; 0 or unset = no restriction
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=<required_strava_app_client_id>
STRAVA_CLIENT_SECRET=<required_strava_app_client_secret>
STRAVA_WEBHOOK_VERIFY_TOKEN=<required_random_strava_verify_token>
STRAVA_SCOPES=read,activity:read,activity:read_all,activity:write,profile:read_all
STRAVA_ALLOWED_ATHLETE_ID=14460791

# -----------------------------------------------------------------------------
# Telegram (required)
# TELEGRAM_ALLOWED_USER_ID: numeric Telegram user id allowed to use the bot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<required_botfather_bot_token>
TELEGRAM_WEBHOOK_SECRET=<required_long_random_webhook_secret>
TELEGRAM_ALLOWED_USER_ID=<required_numeric_telegram_user_id>

# -----------------------------------------------------------------------------
# Auth
# APP_SECRET_KEY: strong random value (32+ chars); also used to derive MCP API
#   key hashes and as the JWT signing fallback.
# JWT_SECRET_KEY: optional dedicated JWT signing secret; falls back to
#   APP_SECRET_KEY when unset. Previously named JWT_SECRET (still accepted).
# COOKIE_SECURE: true when serving over HTTPS (previously JWT_COOKIE_SECURE).
# The auth cookie name, SameSite (lax), and domain are fixed in code.
# -----------------------------------------------------------------------------
APP_SECRET_KEY=<required_random_32_plus_char_secret>
JWT_SECRET_KEY=<optional_if_reusing_APP_SECRET_KEY_random_32_plus_char_secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# CORS (optional)
# Comma-separated browser origins allowed by the API. Leave unset for the
# same-origin panel setup (no CORS middleware is mounted when empty).
# -----------------------------------------------------------------------------
# CORS_ORIGINS=

# -----------------------------------------------------------------------------
# URLs
# PUBLIC_BASE_URL: required in production; drives webhook URL registration.
# FRONTEND_BASE_URL: optional; defaults to PUBLIC_BASE_URL when unset.
# VITE_API_BASE_URL: baked into the frontend image at build time.
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=<required_https_base_url_used_for_webhook_url_derivation>
FRONTEND_BASE_URL=
UI_API_BASE_URL=/api
VITE_API_BASE_URL=/api

# -----------------------------------------------------------------------------
# Compose ports and image tags (host-side, managed by the VPS control panel)
# -----------------------------------------------------------------------------
BACKEND_PORT=8002
FRONTEND_PORT=3002
MCP_PORT=8004
DOCKER_IMAGE_API=api-main-latest
DOCKER_IMAGE_FRONTEND=frontend-main-latest
DOCKER_IMAGE_MCP=mcp-main-latest
